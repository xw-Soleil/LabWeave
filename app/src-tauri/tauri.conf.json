{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LabWeave",
  "version": "0.1.0",
  "identifier": "com.ai4know.researchworkbench",
  "build": {
    "beforeDevCommand": "pnpm --filter @graphif/project-graph dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "beforeBundleCommand": "node ./scripts/prepare-bundle.js",
    "frontendDist": "../dist",
    "removeUnusedCommands": false
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "科研工作台",
        "url": "/index.html",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "noRedirectionBitmap": true,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "rpm", "dmg", "app"],
    "createUpdaterArtifacts": false,
    "category": "Productivity",
    "longDescription": "A local-only research workbench based on Project Graph: papers, images and notes from one research folder on a whiteboard.",
    "shortDescription": "Research workbench",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "TradChinese", "English", "Indonesian"],
        "sidebarImage": "nsis/left.bmp",
        "headerImage": "nsis/project-graph-install.bmp"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 720, "height": 460 },
        "appPosition": { "x": 184, "y": 254 },
        "applicationFolderPosition": { "x": 536, "y": 254 }
      }
    },
    "fileAssociations": [
      {
        "name": "LabWeave Workspace",
        "description": "LabWeave Workspace",
        "ext": ["prg"],
        "mimeType": "application/vnd.project-graph",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["rwb"]
      }
    },
    "cli": {
      "description": "A simple tool to create topology diagrams.",
      "args": [
        {
          "name": "path",
          "index": 1,
          "takesValue": true
        },
        {
          "name": "output",
          "short": "o",
          "takesValue": true,
          "multiple": false
        },
        {
          "name": "size",
          "short": "s",
          "takesValue": true,
          "multiple": false
        }
      ]
    },
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "shell": {
      "open": ".*"
    }
  }
}
